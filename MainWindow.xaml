<Window
    x:Class="SmallBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmallBrowser"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Small Browser - WinUI3 + WebView2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar Drag Region -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Height="32" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <FontIcon Glyph="&#xE774;" FontSize="14" Margin="0,0,8,0" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                <TextBlock Text="SmallBrowser (Low-RAM Shell)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Tab Strip Row -->
        <TabView Grid.Row="1"
                 x:Name="MainTabView"
                 AddTabButtonClick="MainTabView_AddTabButtonClick"
                 TabCloseRequested="MainTabView_TabCloseRequested"
                 SelectionChanged="MainTabView_SelectionChanged"
                 IsAddTabButtonVisible="True"
                 Padding="0">
        </TabView>

        <!-- Toolbar and Browser Viewport -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Address Bar & Navigation Toolbar -->
            <Grid Grid.Row="0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Controls -->
                <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_Click" ToolTipService.ToolTip="Back" Margin="0,0,4,0">
                    <SymbolIcon Symbol="Back"/>
                </Button>

                <Button Grid.Column="1" x:Name="ForwardButton" Click="ForwardButton_Click" ToolTipService.ToolTip="Forward" Margin="0,0,4,0">
                    <SymbolIcon Symbol="Forward"/>
                </Button>

                <Button Grid.Column="2" x:Name="ReloadButton" Click="ReloadButton_Click" ToolTipService.ToolTip="Reload" Margin="0,0,4,0">
                    <SymbolIcon Symbol="Refresh"/>
                </Button>

                <Button Grid.Column="3" x:Name="StopButton" Click="StopButton_Click" ToolTipService.ToolTip="Stop" Margin="0,0,8,0">
                    <SymbolIcon Symbol="Cancel"/>
                </Button>

                <!-- Address Input Bar -->
                <TextBox Grid.Column="4"
                         x:Name="AddressBar"
                         PlaceholderText="Search Google or enter address"
                         KeyDown="AddressBar_KeyDown"
                         GotFocus="AddressBar_GotFocus"
                         VerticalAlignment="Center"
                         CornerRadius="4"/>

                <!-- Loading Indicator -->
                <ProgressRing Grid.Column="5"
                              x:Name="LoadingRing"
                              IsActive="False"
                              Width="20"
                              Height="20"
                              Margin="8,0,8,0"
                              VerticalAlignment="Center"/>

                <!-- Tab Discard / Hibernation Control Panel -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button x:Name="DiscardCurrentButton" Click="DiscardCurrentButton_Click" ToolTipService.ToolTip="Hibernate current tab now to free RAM">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE945;" FontSize="12"/>
                            <TextBlock Text="Sleep Tab" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <ComboBox x:Name="DiscardTimeoutCombo"
                              SelectionChanged="DiscardTimeoutCombo_SelectionChanged"
                              Width="130"
                              ToolTipService.ToolTip="Inactive Tab Discard Timeout">
                        <ComboBoxItem Content="Discard: 1 min"/>
                        <ComboBoxItem Content="Discard: 5 mins" IsSelected="True"/>
                        <ComboBoxItem Content="Discard: 10 mins"/>
                        <ComboBoxItem Content="Discard: Never"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Active Tab Content Area -->
            <Grid Grid.Row="1" x:Name="TabContentContainer" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <!-- Tab host container goes here -->
            </Grid>

        </Grid>
    </Grid>

</Window>
